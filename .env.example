# Copy to .env and fill in. The .env file is gitignored and never reaches the repository.
# If a key ever lands in a commit, deleting the file is NOT enough — git history is
# permanent. The only real fix is to revoke the key with the provider.

# Generation model and judge model
ANTHROPIC_API_KEY=

# Embedding model for the RAG arm
OPENAI_API_KEY=
